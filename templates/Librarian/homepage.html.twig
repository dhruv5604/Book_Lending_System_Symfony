{% extends 'base.html.twig' %}

{% block title %}Homepage{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Welcome To Homepage</h1>

    {% if is_granted('ROLE_LIBRARIAN') %}
        <h2 class="mb-3">All Books</h2>
        <a href="{{ path('app_add_book') }}" class="btn btn-primary btn-sm mb-3">Add Book</a>
        <a href="{{ path('app_dashboard_loans') }}" class="btn btn-primary btn-sm mb-3">All Loans</a>
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th scope="col">#ID</th>
                    <th scope="col">Title</th>
                    <th scope="col">Author</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for book in books %}
                    <tr>
                        <td>{{ book.id }}</td>
                        <td>{{ book.title }}</td>
                        <td>{{ book.author }}</td>
                        <td>
                            <a href="{{ path('app_edit_book',{
                                "id": book.id   
                            }) }}" class="btn btn-primary btn-sm">Edit</a>
                            <a href="{{ path('app_delete_book',{
                                "id": book.id   
                            }) }}" class="btn btn-primary btn-sm">Delete</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="alert alert-warning">
            You must be logged in with the <strong>Librarian</strong> role to view the book list.
        </div>
    {% endif %} 
</div>
{% endblock %}
