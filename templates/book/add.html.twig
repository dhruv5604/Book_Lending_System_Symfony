{% extends 'base.html.twig' %}

{% block title %}{{ form.vars.value.id ? 'Edit Book' : 'Add Book' }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2>{{ form.vars.value.id ? 'Edit Book' : 'Add Book' }}</h2>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-success mt-3">{{ form.vars.value.id ? 'Update' : 'Create' }}</button>
    {{ form_end(form) }}
</div>
{% endblock %}
