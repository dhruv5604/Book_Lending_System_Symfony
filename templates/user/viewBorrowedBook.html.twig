{% extends 'base.html.twig' %}

{% block title %}Borrowed Books{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Your Borrowed Books</h1>

    {% if borrowed_books is not empty %}
        <div {{ stimulus_controller('view-available-book') }}>
        <table id="table1" class="table table-bordered table-hover shadow-sm">
            <thead class="table-primary">
                <tr>
                    <th>#ID</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Borrowed Date</th>
                    <th>Due At</th>
                    <th>Return Date</th>
                </tr>
            </thead>
            <tbody>
                {% for book in borrowed_books %}
                    {% for loan in book.loans %}
                        {% if loan.user.id == app.user.id %}
                            <tr>
                                <td>{{ loan.id }}</td>
                                <td>{{ book.title }}</td>
                                <td>{{ book.author }}</td>
                                <td>{{ loan.loanedAt ? loan.loanedAt|date('Y-m-d') : 'N/A' }}</td>
                                <td>{{ loan.dueAt|days_left }}</td>
                                <td>
                                    {% if loan.returnedAt %}
                                        {{ loan.returnedAt|date('Y-m-d') }}
                                    {% else %}
                                        <a href="{{ path('app_return_book',{
                                            "id": loan.id
                                        }) }}" class="btn btn-primary btn-sm">return</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% else %}
        <div class="alert alert-info">You have not borrowed any books yet.</div>
    {% endif %}
</div>
{% endblock %}
